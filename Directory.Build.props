<Project>
  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFramework)' == ''">netstandard2.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DebugType>portable</DebugType>
    <DVInstallDir Condition="'$(DVInstallDir)' == ''">F:\steam\steamapps\common\Derail Valley</DVInstallDir>
    <DVManagedDir>$(DVInstallDir)\DerailValley_Data\Managed</DVManagedDir>
    <DVModsDir>$(DVInstallDir)\Mods</DVModsDir>
    <SignalsDir Condition="'$(SignalsDir)' == ''">$(DVModsDir)\DVSignals</SignalsDir>
  </PropertyGroup>
</Project>
