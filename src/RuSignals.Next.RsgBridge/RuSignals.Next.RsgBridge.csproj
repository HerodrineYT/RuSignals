    <Reference Include="Signals.Common"><HintPath>$(SignalsDir)\Signals.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Signals.Game"><HintPath>$(SignalsDir)\Signals.Game.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="RailwaySafetyGadgets"><HintPath>$(RsgDir)\RailwaySafetyGadgets.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(GameDir)\DerailValley_Data\Managed\UnityModManager\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameDir)\DerailValley_Data\Managed\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
